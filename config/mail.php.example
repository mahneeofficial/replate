<?php
declare(strict_types=1);

// Email Server Configuration Template
// Copy this file to config/mail.php and fill in your actual SMTP details or use environment variables.

define('MAIL_HOST', $_ENV['MAIL_HOST'] ?? getenv('MAIL_HOST') ?: 'smtp.gmail.com');
define('MAIL_PORT', (int)($_ENV['MAIL_PORT'] ?? getenv('MAIL_PORT') ?: 587));
define('MAIL_USER', $_ENV['MAIL_USER'] ?? getenv('MAIL_USER') ?: 'your-email@gmail.com');
define('MAIL_PASS', $_ENV['MAIL_PASS'] ?? getenv('MAIL_PASS') ?: 'your-app-password');
define('MAIL_FROM', $_ENV['MAIL_FROM'] ?? getenv('MAIL_FROM') ?: 'your-email@gmail.com');
define('MAIL_FROM_NAME', $_ENV['MAIL_FROM_NAME'] ?? getenv('MAIL_FROM_NAME') ?: 'RePlate Team');

/**
 * Wrap standard HTML body into a styled email template
 */
function wrapEmailTemplate(string $title, string $content): string {
    return '
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="UTF-8">
        <style>
            body { font-family: Arial, sans-serif; background-color: #f4f6f8; margin: 0; padding: 20px; color: #333333; }
            .email-card { max-width: 550px; margin: 0 auto; background: #ffffff; padding: 30px; border-radius: 10px; border: 1px solid #e2e8f0; }
            h2 { font-size: 22px; color: #1e293b; margin-top: 0; }
            p, li { font-size: 16px; line-height: 1.6; color: #475569; }
            .code-box { font-size: 28px; font-weight: bold; letter-spacing: 4px; color: #0284c7; background: #f0f9ff; padding: 14px; text-align: center; border-radius: 6px; margin: 20px 0; border: 1px dashed #0284c7; }
            .footer { font-size: 13px; color: #94a3b8; text-align: center; margin-top: 25px; }
        </style>
    </head>
    <body>
        <div class="email-card">
            <h2>' . htmlspecialchars($title, ENT_QUOTES, 'UTF-8') . '</h2>
            ' . $content . '
            <div class="footer">&copy; ' . date('Y') . ' RePlate System. All rights reserved.</div>
        </div>
    </body>
    </html>';
}

/**
 * Send an HTML email via SMTP using native sockets.
 */
function sendEmail(string $toEmail, string $subject, string $htmlBody, bool $autoWrap = true): bool {
    $body = $autoWrap ? wrapEmailTemplate($subject, $htmlBody) : $htmlBody;

    $socket = @fsockopen(MAIL_HOST, MAIL_PORT, $errno, $errstr, 15);
    if (!$socket) {
        error_log("SMTP Connection Error: $errstr ($errno)");
        return false;
    }

    $read = function($sock) {
        $response = "";
        while ($str = fgets($sock, 512)) {
            $response .= $str;
            if (substr($str, 3, 1) === " ") break;
        }
        return $response;
    };

    $read($socket);

    fwrite($socket, "EHLO " . gethostname() . "\r\n");
    $read($socket);

    fwrite($socket, "STARTTLS\r\n");
    $response = $read($socket);
    if (substr($response, 0, 3) !== '220') {
        fclose($socket);
        return false;
    }

    stream_socket_enable_crypto($socket, true, STREAM_CRYPTO_METHOD_TLSv1_2_CLIENT | STREAM_CRYPTO_METHOD_TLSv1_3_CLIENT);

    fwrite($socket, "EHLO " . gethostname() . "\r\n");
    $read($socket);

    fwrite($socket, "AUTH LOGIN\r\n");
    $read($socket);

    fwrite($socket, base64_encode(MAIL_USER) . "\r\n");
    $read($socket);

    fwrite($socket, base64_encode(MAIL_PASS) . "\r\n");
    $authRes = $read($socket);
    if (substr($authRes, 0, 3) !== '235') {
        fclose($socket);
        return false;
    }

    fwrite($socket, "MAIL FROM: <" . MAIL_FROM . ">\r\n");
    $read($socket);

    fwrite($socket, "RCPT TO: <$toEmail>\r\n");
    $read($socket);

    fwrite($socket, "DATA\r\n");
    $read($socket);

    $headers  = "MIME-Version: 1.0\r\n";
    $headers .= "Content-Type: text/html; charset=UTF-8\r\n";
    $headers .= "Date: " . date(DATE_RFC2822) . "\r\n";
    $headers .= "From: " . MAIL_FROM_NAME . " <" . MAIL_FROM . ">\r\n";
    $headers .= "To: <$toEmail>\r\n";
    $headers .= "Subject: $subject\r\n";

    fwrite($socket, $headers . "\r\n" . $body . "\r\n.\r\n");
    $dataRes = $read($socket);

    fwrite($socket, "QUIT\r\n");
    fclose($socket);

    return substr($dataRes, 0, 3) === '250';
}